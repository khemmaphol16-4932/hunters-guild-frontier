{
  "name": "hunters-guild-frontier",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hunter's Guild: Frontier — autonomous Hunter Guild management RPG",
  "scripts": {
    "predev": "node art/tools/bake-buildings.mjs",
    "dev": "vite",
    "prebuild": "node art/tools/bake-buildings.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "art:prompts": "node art/prompts/build.mjs",
    "art:export": "node art/tools/export.mjs",
    "art:reference": "node art/tools/reference.mjs",
    "art:bake": "node art/tools/bake-buildings.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
